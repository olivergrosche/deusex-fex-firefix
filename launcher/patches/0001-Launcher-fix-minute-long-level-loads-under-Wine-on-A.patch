diff --git a/launcher/src/FastFileReader.cpp b/launcher/src/FastFileReader.cpp
new file mode 100644
index 0000000..a88a90b
--- /dev/null
+++ b/launcher/src/FastFileReader.cpp
@@ -0,0 +1,359 @@
+#include "stdafx.h"
+#include "FastFileReader.h"
+#include "PathCache.h"
+
+// See FastFileReader.h. Measured on the PC for the main menu map (DX.dx):
+// the engine's reader issues ~60,000 ReadFile and ~83,000 SetFilePointer
+// calls (68 MB).
+//
+// Strategy per opened package:
+// 1. Map the whole file read-only (CreateFileMapping/MapViewOfFile). Every
+//    Seek/Serialize is then a memcpy - no syscalls at all; page faults are
+//    served by the host kernel. Capped by a global address-space budget: the
+//    process is 32-bit, and DXVK and HD texture packs need address space too.
+// 2. If mapping fails or the budget is used up: a buffered reader that reads
+//    what the engine announces via Precache() (the export's serial size),
+//    at least BlockSize, and serves seeks inside the buffer from memory.
+//
+// [DeusExe] FastFileReader=False uses the engine's own reader instead.
+namespace
+{
+    constexpr INT BlockSize = 32 * 1024;          // minimum refill of the buffered reader
+    constexpr INT MaxBufferSize = 1024 * 1024;    // largest refill (big Precache hints)
+    constexpr LONGLONG MapBudget = 512LL * 1024 * 1024;
+
+    bool s_bEnabled = true;
+    volatile LONG s_lReads = 0;
+    volatile LONG s_lSeeks = 0;
+    volatile LONG s_lKBytes = 0;
+    volatile LONG s_lMaps = 0;
+    volatile LONG s_lMapKBytes = 0;
+    volatile LONGLONG s_llMapped = 0;              // bytes currently mapped
+
+    void LogReadError(FOutputDevice* pError, const wchar_t* pszWhat, INT iA, INT iB)
+    {
+        pError->Logf(L"%s (%i/%i): %s", pszWhat, iA, iB, appGetSystemErrorMessage());
+    }
+
+    // ------------------------------------------------------------------
+    // Memory-mapped reader
+    // ------------------------------------------------------------------
+    class FArchiveMappedFileReader : public FArchive
+    {
+    public:
+        FArchiveMappedFileReader(HANDLE hFile, HANDLE hMapping, const BYTE* pView, INT iSize, FOutputDevice* pError)
+            : m_hFile(hFile), m_hMapping(hMapping), m_pView(pView), m_iSize(iSize), m_iPos(0), m_pError(pError)
+        {
+            ArIsLoading = ArIsPersistent = 1;
+        }
+
+        ~FArchiveMappedFileReader()
+        {
+            Close();
+        }
+
+        void Seek(INT iPos) override
+        {
+            check(iPos >= 0);
+            check(iPos <= m_iSize);
+            m_iPos = iPos;
+        }
+
+        INT Tell() override { return m_iPos; }
+        INT TotalSize() override { return m_iSize; }
+        void Precache(INT /*HintCount*/) override {}
+
+        UBOOL Close() override
+        {
+            if (m_pView)
+            {
+                UnmapViewOfFile(m_pView);
+                InterlockedExchangeAdd64(&s_llMapped, -static_cast<LONGLONG>(m_iSize));
+                m_pView = nullptr;
+            }
+            if (m_hMapping)
+            {
+                CloseHandle(m_hMapping);
+                m_hMapping = nullptr;
+            }
+            if (m_hFile)
+            {
+                CloseHandle(m_hFile);
+                m_hFile = nullptr;
+            }
+            return !ArIsError;
+        }
+
+        void Serialize(void* pData, INT iLength) override
+        {
+            if (iLength <= 0)
+            {
+                return;
+            }
+            if (!m_pView || iLength > m_iSize - m_iPos)
+            {
+                ArIsError = 1;
+                if (m_pError)
+                {
+                    m_pError->Logf(L"ReadFile beyond EOF %i+%i/%i", m_iPos, iLength, m_iSize);
+                }
+                return;
+            }
+            appMemcpy(pData, m_pView + m_iPos, iLength);
+            m_iPos += iLength;
+        }
+
+    private:
+        HANDLE m_hFile;
+        HANDLE m_hMapping;
+        const BYTE* m_pView;
+        INT m_iSize;
+        INT m_iPos;
+        FOutputDevice* m_pError;
+    };
+
+    // ------------------------------------------------------------------
+    // Buffered reader (fallback when a file can't be mapped)
+    // ------------------------------------------------------------------
+    class FArchiveBufferedFileReader : public FArchive
+    {
+    public:
+        FArchiveBufferedFileReader(HANDLE hFile, FOutputDevice* pError, INT iSize)
+            : m_hFile(hFile), m_pError(pError), m_iSize(iSize),
+              m_iPos(0), m_iOsPos(0), m_iBufferBase(0), m_iBufferCount(0), m_iHint(0),
+              m_iCapacity(Min(BlockSize, Max(iSize, 1))),
+              m_pBuffer(static_cast<BYTE*>(appMalloc(m_iCapacity, L"FastFileReader")))
+        {
+            ArIsLoading = ArIsPersistent = 1;
+        }
+
+        ~FArchiveBufferedFileReader()
+        {
+            if (m_hFile)
+            {
+                Close();
+            }
+            appFree(m_pBuffer);
+        }
+
+        void Seek(INT iPos) override
+        {
+            check(iPos >= 0);
+            check(iPos <= m_iSize);
+            // No OS call: the file pointer moves lazily in OsRead and a target
+            // inside the buffer is served from memory.
+            m_iPos = iPos;
+            m_iHint = 0;
+        }
+
+        INT Tell() override { return m_iPos; }
+        INT TotalSize() override { return m_iSize; }
+
+        void Precache(INT iHintCount) override
+        {
+            // ULinkerLoad calls Seek(SerialOffset) + Precache(SerialSize)
+            // before deserializing an export: read that much in one go.
+            m_iHint = Max(iHintCount, 0);
+        }
+
+        UBOOL Close() override
+        {
+            if (m_hFile)
+            {
+                CloseHandle(m_hFile);
+            }
+            m_hFile = nullptr;
+            return !ArIsError;
+        }
+
+        void Serialize(void* pData, INT iLength) override
+        {
+            BYTE* pOut = static_cast<BYTE*>(pData);
+            while (iLength > 0)
+            {
+                if (m_iPos < m_iBufferBase || m_iPos >= m_iBufferBase + m_iBufferCount)
+                {
+                    if (iLength >= MaxBufferSize)
+                    {
+                        // Huge read: straight into the caller's memory.
+                        if (!OsRead(m_iPos, pOut, iLength))
+                        {
+                            return;
+                        }
+                        m_iPos += iLength;
+                        return;
+                    }
+                    if (!Refill(iLength))
+                    {
+                        return;
+                    }
+                }
+                const INT iCopy = Min(iLength, m_iBufferBase + m_iBufferCount - m_iPos);
+                appMemcpy(pOut, m_pBuffer + (m_iPos - m_iBufferBase), iCopy);
+                m_iPos += iCopy;
+                iLength -= iCopy;
+                pOut += iCopy;
+            }
+        }
+
+    private:
+        bool Refill(INT iLength)
+        {
+            const INT iWant = Min(Max(Max(m_iHint, iLength), BlockSize), MaxBufferSize);
+            m_iHint = 0;
+            if (iWant > m_iCapacity)
+            {
+                BYTE* const pNew = static_cast<BYTE*>(appMalloc(iWant, L"FastFileReader"));
+                appFree(m_pBuffer);
+                m_pBuffer = pNew;
+                m_iCapacity = iWant;
+                m_iBufferCount = 0;
+            }
+            const INT iCount = Min(iWant, m_iSize - m_iPos);
+            if (iCount <= 0)
+            {
+                ArIsError = 1;
+                m_pError->Logf(L"ReadFile beyond EOF %i+%i/%i", m_iPos, iLength, m_iSize);
+                return false;
+            }
+            m_iBufferBase = m_iPos;
+            m_iBufferCount = 0;
+            if (!OsRead(m_iPos, m_pBuffer, iCount))
+            {
+                return false;
+            }
+            m_iBufferCount = iCount;
+            return true;
+        }
+
+        bool MoveOsPointer(INT iAt)
+        {
+            if (m_iOsPos == iAt)
+            {
+                return true;
+            }
+            InterlockedIncrement(&s_lSeeks);
+            if (SetFilePointer(m_hFile, iAt, nullptr, FILE_BEGIN) == INVALID_SET_FILE_POINTER)
+            {
+                ArIsError = 1;
+                LogReadError(m_pError, L"SetFilePointer failed", iAt, m_iSize);
+                m_iOsPos = -1;
+                return false;
+            }
+            m_iOsPos = iAt;
+            return true;
+        }
+
+        bool OsRead(INT iAt, void* pDest, INT iCount)
+        {
+            if (!MoveOsPointer(iAt))
+            {
+                return false;
+            }
+            DWORD dwRead = 0;
+            InterlockedIncrement(&s_lReads);
+            const BOOL bOk = ReadFile(m_hFile, pDest, iCount, &dwRead, nullptr);
+            InterlockedExchangeAdd(&s_lKBytes, static_cast<LONG>(dwRead / 1024));
+            m_iOsPos = bOk ? m_iOsPos + static_cast<INT>(dwRead) : -1;
+            if (!bOk || static_cast<INT>(dwRead) != iCount)
+            {
+                ArIsError = 1;
+                LogReadError(m_pError, L"ReadFile failed", static_cast<INT>(dwRead), iCount);
+                return false;
+            }
+            return true;
+        }
+
+        HANDLE m_hFile;
+        FOutputDevice* m_pError;
+        INT m_iSize;
+        INT m_iPos;          // logical position
+        INT m_iOsPos;        // OS file pointer (-1 = unknown)
+        INT m_iBufferBase;   // file offset of m_pBuffer[0]
+        INT m_iBufferCount;  // valid bytes in m_pBuffer
+        INT m_iHint;         // pending Precache size
+        INT m_iCapacity;     // size of m_pBuffer
+        BYTE* m_pBuffer;
+    };
+
+    FArchive* TryMap(HANDLE hFile, INT iSize, FOutputDevice* pError)
+    {
+        if (iSize <= 0)
+        {
+            return nullptr;  // CreateFileMapping rejects empty files
+        }
+        if (InterlockedExchangeAdd64(&s_llMapped, iSize) + iSize > MapBudget)
+        {
+            InterlockedExchangeAdd64(&s_llMapped, -static_cast<LONGLONG>(iSize));
+            return nullptr;
+        }
+        const HANDLE hMapping = CreateFileMappingW(hFile, nullptr, PAGE_READONLY, 0, 0, nullptr);
+        const void* const pView = hMapping ? MapViewOfFile(hMapping, FILE_MAP_READ, 0, 0, 0) : nullptr;
+        if (!pView)
+        {
+            if (hMapping)
+            {
+                CloseHandle(hMapping);
+            }
+            InterlockedExchangeAdd64(&s_llMapped, -static_cast<LONGLONG>(iSize));
+            return nullptr;
+        }
+        InterlockedIncrement(&s_lMaps);
+        InterlockedExchangeAdd(&s_lMapKBytes, iSize / 1024);
+#pragma warning(suppress: 4291)
+        return new(L"FastFileReader") FArchiveMappedFileReader(hFile, hMapping, static_cast<const BYTE*>(pView), iSize, pError);
+    }
+}
+
+FArchive* FastFileReader::Create(const wchar_t* Filename, DWORD Flags, FOutputDevice* Error)
+{
+    //Open by the name as spelled on disk where known: under Wine on a
+    //case-sensitive file system a differently cased name costs a directory
+    //scan ("..\Maps\entry.dx" for Entry.dx).
+    wchar_t szActual[MAX_PATH];
+    const HANDLE hFile = CreateFileW(PathCache::Lookup(Filename, szActual).Kind == PathCache::EKind::File ? szActual : Filename,
+        GENERIC_READ, FILE_SHARE_READ, nullptr, OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (hFile == INVALID_HANDLE_VALUE)
+    {
+        if (Flags & FILEREAD_NoFail)
+        {
+            appErrorf(L"Failed to read file: %s", Filename);
+        }
+        return nullptr;
+    }
+    const INT iSize = static_cast<INT>(GetFileSize(hFile, nullptr));
+    // Same tagged allocations as the engine's own reader (freed with delete by ULinkerLoad).
+    if (!s_bEnabled)
+    {
+#pragma warning(suppress: 4291)
+        return new(L"WindowsFileReader") FArchiveFileReader(hFile, Error, iSize);
+    }
+    if (FArchive* const pMapped = TryMap(hFile, iSize, Error))
+    {
+        return pMapped;
+    }
+#pragma warning(suppress: 4291)
+    return new(L"FastFileReader") FArchiveBufferedFileReader(hFile, Error, iSize);
+}
+
+bool FastFileReader::Enabled()
+{
+    return s_bEnabled;
+}
+
+void FastFileReader::ReadConfig()
+{
+    UBOOL bEnabled = TRUE;
+    GConfig->GetBool(PROJECTNAME, L"FastFileReader", bEnabled);
+    s_bEnabled = bEnabled != FALSE;
+    GLog->Logf(L"File reader: %s.", s_bEnabled ? L"memory-mapped (buffered fallback)" : L"the engine's own (not counted below)");
+}
+
+void FastFileReader::TakeStats(INT& Reads, INT& Seeks, INT& KBytes, INT& Maps, INT& MapKBytes)
+{
+    Reads = InterlockedExchange(&s_lReads, 0);
+    Seeks = InterlockedExchange(&s_lSeeks, 0);
+    KBytes = InterlockedExchange(&s_lKBytes, 0);
+    Maps = InterlockedExchange(&s_lMaps, 0);
+    MapKBytes = InterlockedExchange(&s_lMapKBytes, 0);
+}
diff --git a/launcher/src/FastFileReader.h b/launcher/src/FastFileReader.h
new file mode 100644
index 0000000..8b5c85c
--- /dev/null
+++ b/launcher/src/FastFileReader.h
@@ -0,0 +1,27 @@
+#pragma once
+
+// Package reader replacing the engine's FArchiveFileReader.
+//
+// The stock reader (Core/Inc/FFileManagerWindows.h) has a 1 KB buffer and
+// every Seek() calls SetFilePointer and drops the buffer, even when the
+// target is already buffered. Loading a level preloads every export, i.e.
+// a Seek plus one or more <=1 KB ReadFile calls per object - tens of
+// thousands of syscalls per map, each a round trip through Wine and FEX on
+// Android. (The minute-long loads there were failed file lookups, though,
+// not reads - see PathCache.h.)
+//
+// This reader maps the file into memory where it can, and otherwise keeps a
+// large buffer, serves seeks inside it without touching the OS, and only
+// moves the file pointer right before a real read.
+namespace FastFileReader
+{
+    // Same contract as FFileManagerWindows::CreateFileReader.
+    FArchive* Create(const wchar_t* Filename, DWORD Flags, FOutputDevice* Error);
+
+    // Enabled by default; [DeusExe] FastFileReader=False uses the engine's own reader.
+    bool Enabled();
+    void ReadConfig();
+
+    // Totals since the previous call: OS reads, OS seeks, KB read; files mapped, KB mapped.
+    void TakeStats(INT& Reads, INT& Seeks, INT& KBytes, INT& Maps, INT& MapKBytes);
+}
diff --git a/launcher/src/FileHooks.cpp b/launcher/src/FileHooks.cpp
new file mode 100644
index 0000000..6e8a096
--- /dev/null
+++ b/launcher/src/FileHooks.cpp
@@ -0,0 +1,1390 @@
+#include "stdafx.h"
+#include "FileHooks.h"
+#include "PathCache.h"
+#include "Symbols.h"
+
+#include <intrin.h>
+#include <psapi.h>
+#pragma comment(lib, "psapi.lib")
+
+#pragma intrinsic(_ReturnAddress, _AddressOfReturnAddress)
+
+namespace
+{
+    enum EApi
+    {
+        Api_CreateFileW,
+        Api_CreateFileA,
+        Api_GetFileAttributesW,
+        Api_GetFileAttributesA,
+        Api_GetFileAttributesExW,
+        Api_GetFileAttributesExA,
+        Api_FindFirstFileW,
+        Api_FindFirstFileA,
+        Api_FindFirstFileExW,
+        Api_FindFirstFileExA,
+        Api_CopyFileW,
+        Api_CopyFileA,
+        Api_CopyFileExW,
+        Api_CopyFileExA,
+        Api_MoveFileW,
+        Api_MoveFileA,
+        Api_MoveFileExW,
+        Api_MoveFileExA,
+        Api_DeleteFileW,
+        Api_DeleteFileA,
+        Api_CreateDirectoryW,
+        Api_CreateDirectoryA,
+        Api_RemoveDirectoryW,
+        Api_RemoveDirectoryA,
+        Api_LoadLibraryW,
+        Api_LoadLibraryA,
+        Api_LoadLibraryExW,
+        Api_LoadLibraryExA,
+        Api_Count
+    };
+
+    struct FTarget
+    {
+        const char* pszName;
+        void* pfnHook;
+        void* pfnOriginal;  //What the hook calls: what imports from kernel32 resolve to
+        void* pfnAlt;       //The kernelbase export, for imports through kernelbase or API sets
+    };
+
+    FTarget s_aTargets[Api_Count]; //Filled by Install()
+
+    // ---- trace data: fixed tables, written from any thread under s_TraceLock ----
+
+    constexpr int MaxFrames = 6;        //Direct caller, then the next return addresses found on the stack
+    constexpr int MaxCallers = 2048;
+    constexpr int MaxFiles = 8192;
+    constexpr int NameChars = 120;
+
+    struct FApiStat
+    {
+        LONG lCount;
+        LONG lFailed;
+        LONG lCached;                   //Answered from the path cache
+        LONGLONG llTicks;
+    };
+
+    struct FCallerStat
+    {
+        bool bUsed;
+        WORD wApi;
+        DWORD dwHash;
+        DWORD aFrames[MaxFrames];
+        LONG lCount;
+        LONG lFailed;
+        LONG lCached;
+        LONGLONG llTicks;
+        wchar_t szExample[NameChars];
+    };
+
+    struct FFileStat
+    {
+        bool bUsed;
+        WORD wApi;
+        DWORD dwHash;
+        LONG lCount;
+        LONG lFailed;
+        LONG lCached;
+        LONGLONG llTicks;
+        wchar_t szName[NameChars];
+    };
+
+    struct FTrace
+    {
+        FApiStat aApis[Api_Count];
+        FCallerStat aCallers[MaxCallers];
+        FFileStat aFiles[MaxFiles];
+        LONG lDroppedCallers;
+        LONG lDroppedFiles;
+    };
+
+    FTrace* s_pTrace = nullptr; //VirtualAlloc'ed: the engine's allocator isn't thread-safe
+    SRWLOCK s_TraceLock = SRWLOCK_INIT;
+
+    // ---- module ranges, for telling return addresses on the stack ----
+
+    struct FModuleRange
+    {
+        DWORD dwBase;
+        DWORD dwEnd;
+    };
+
+    struct FModuleTable
+    {
+        int iCount;
+        FModuleRange aRanges[512]; //Sorted by base
+    };
+
+    //Replaced, never freed, when the module set changes: hooks on other threads may still read the old one
+    FModuleTable* volatile s_pModules = nullptr;
+
+    volatile bool s_bActive = false;    //False: hooks only pass through
+    volatile bool s_bTrace = false;
+    volatile bool s_bUseCache = false;
+    HMODULE s_hKernel32 = nullptr;
+    HMODULE s_hKernelBase = nullptr;
+    HMODULE s_hNtdll = nullptr;
+    CRITICAL_SECTION s_csPatch;
+    LONG s_lPatchedSlots = 0;
+    LARGE_INTEGER s_liFreq = {};
+
+    // ---- stack scan ----
+
+    bool ReadCodeBytes(const DWORD dwAddr, BYTE(&b)[7])
+    {
+        __try
+        {
+            memcpy(b, reinterpret_cast<const void*>(dwAddr - 7), 7);
+            return true;
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            return false;
+        }
+    }
+
+    const FModuleRange* FindModule(const FModuleTable& Table, const DWORD dwAddr)
+    {
+        int iLow = 0;
+        int iHigh = Table.iCount - 1;
+        while (iLow <= iHigh)
+        {
+            const int iMid = (iLow + iHigh) / 2;
+            if (dwAddr < Table.aRanges[iMid].dwBase)
+            {
+                iHigh = iMid - 1;
+            }
+            else if (dwAddr >= Table.aRanges[iMid].dwEnd)
+            {
+                iLow = iMid + 1;
+            }
+            else
+            {
+                return &Table.aRanges[iMid];
+            }
+        }
+        return nullptr;
+    }
+
+    bool InModule(const FModuleTable& Table, const DWORD dwAddr)
+    {
+        return FindModule(Table, dwAddr) != nullptr;
+    }
+
+    //A return address points just past a CALL instruction. The 7 bytes
+    //checked must lie in the same image: a module base on the stack (an
+    //HMODULE) would otherwise fault, and every first-chance fault costs a
+    //signal round trip under Wine and replaces CrashContext's record of the
+    //last real one.
+    bool LooksLikeReturnAddress(const FModuleTable& Table, const DWORD dwAddr)
+    {
+        const FModuleRange* const pRange = FindModule(Table, dwAddr);
+        if (!pRange || dwAddr - pRange->dwBase < 7)
+        {
+            return false;
+        }
+        BYTE b[7];
+        if (!ReadCodeBytes(dwAddr, b))
+        {
+            return false;
+        }
+        return b[2] == 0xE8                                 //call rel32
+            || (b[1] == 0xFF && (b[2] & 0x38) == 0x10)      //call [disp32] / [reg+disp32]
+            || (b[4] == 0xFF && (b[5] & 0x38) == 0x10)      //call [reg+disp8] / [reg+reg]
+            || (b[5] == 0xFF && (b[6] & 0xF8) == 0xD0)      //call reg
+            || (b[5] == 0xFF && (b[6] & 0x38) == 0x10)      //call [reg]
+            || (b[0] == 0xFF && (b[1] & 0x38) == 0x10);     //call [reg*scale+disp32]
+    }
+
+    int ScanStack(const DWORD* const pFrom, DWORD* const pOut, const int iMax)
+    {
+        const FModuleTable* const pTable = s_pModules;
+        if (!pTable)
+        {
+            return 0;
+        }
+        const DWORD* const pTop = static_cast<const DWORD*>(reinterpret_cast<const NT_TIB*>(NtCurrentTeb())->StackBase);
+        const DWORD* const pEnd = std::min(pTop, pFrom + 1024);
+        int n = 0;
+        for (const DWORD* p = pFrom; p < pEnd && n < iMax; ++p)
+        {
+            if (LooksLikeReturnAddress(*pTable, *p))
+            {
+                pOut[n++] = *p;
+            }
+        }
+        return n;
+    }
+
+    // ---- recording ----
+
+    wchar_t FoldCase(const wchar_t c)
+    {
+        return (c >= L'a' && c <= L'z') ? static_cast<wchar_t>(c - (L'a' - L'A')) : c;
+    }
+
+    bool SameName(const wchar_t* a, const wchar_t* b)
+    {
+        for (; *a && FoldCase(*a) == FoldCase(*b); ++a, ++b)
+        {
+        }
+        return FoldCase(*a) == FoldCase(*b);
+    }
+
+    //Keeps the end of long names: the file name is the interesting part.
+    void CopyName(wchar_t(&szDest)[NameChars], const wchar_t* const pszName)
+    {
+        const size_t iLen = wcslen(pszName);
+        if (iLen < NameChars)
+        {
+            wmemcpy(szDest, pszName, iLen + 1);
+            return;
+        }
+        szDest[0] = szDest[1] = szDest[2] = L'.';
+        wmemcpy(szDest + 3, pszName + iLen - (NameChars - 4), NameChars - 4);
+        szDest[NameChars - 1] = L'\0';
+    }
+
+    void Record(const int iApi, const bool bOk, const bool bCached, const LONGLONG llTicks, const wchar_t* const pszName, const DWORD dwCaller, const DWORD* const pStack)
+    {
+        FTrace* const pTrace = s_pTrace;
+        if (!pTrace)
+        {
+            return;
+        }
+
+        DWORD aFrames[MaxFrames] = {};
+        aFrames[0] = dwCaller;
+        ScanStack(pStack, aFrames + 1, MaxFrames - 1);
+        DWORD dwCallerHash = 2166136261u ^ static_cast<DWORD>(iApi); //FNV-1a
+        for (const DWORD dwFrame : aFrames)
+        {
+            dwCallerHash = (dwCallerHash ^ dwFrame) * 16777619u;
+        }
+
+        wchar_t szName[NameChars] = L"";
+        if (pszName)
+        {
+            CopyName(szName, pszName);
+        }
+        DWORD dwNameHash = 2166136261u ^ static_cast<DWORD>(iApi);
+        for (const wchar_t* p = szName; *p; ++p)
+        {
+            dwNameHash = (dwNameHash ^ FoldCase(*p)) * 16777619u;
+        }
+
+        AcquireSRWLockExclusive(&s_TraceLock);
+
+        FApiStat& Api = pTrace->aApis[iApi];
+        ++Api.lCount;
+        Api.lFailed += bOk ? 0 : 1;
+        Api.lCached += bCached ? 1 : 0;
+        Api.llTicks += llTicks;
+
+        FCallerStat* pCaller = nullptr;
+        for (int i = 0; i < MaxCallers; ++i)
+        {
+            FCallerStat& Slot = pTrace->aCallers[(dwCallerHash + i) % MaxCallers];
+            if (!Slot.bUsed)
+            {
+                Slot.bUsed = true;
+                Slot.wApi = static_cast<WORD>(iApi);
+                Slot.dwHash = dwCallerHash;
+                memcpy(Slot.aFrames, aFrames, sizeof(aFrames));
+                wcscpy_s(Slot.szExample, szName);
+                pCaller = &Slot;
+                break;
+            }
+            if (Slot.dwHash == dwCallerHash && Slot.wApi == iApi && memcmp(Slot.aFrames, aFrames, sizeof(aFrames)) == 0)
+            {
+                pCaller = &Slot;
+                break;
+            }
+        }
+        if (pCaller)
+        {
+            ++pCaller->lCount;
+            pCaller->lFailed += bOk ? 0 : 1;
+            pCaller->lCached += bCached ? 1 : 0;
+            pCaller->llTicks += llTicks;
+        }
+        else
+        {
+            ++pTrace->lDroppedCallers;
+        }
+
+        if (szName[0])
+        {
+            FFileStat* pFile = nullptr;
+            for (int i = 0; i < MaxFiles; ++i)
+            {
+                FFileStat& Slot = pTrace->aFiles[(dwNameHash + i) % MaxFiles];
+                if (!Slot.bUsed)
+                {
+                    Slot.bUsed = true;
+                    Slot.wApi = static_cast<WORD>(iApi);
+                    Slot.dwHash = dwNameHash;
+                    wcscpy_s(Slot.szName, szName);
+                    pFile = &Slot;
+                    break;
+                }
+                if (Slot.dwHash == dwNameHash && Slot.wApi == iApi && SameName(Slot.szName, szName))
+                {
+                    pFile = &Slot;
+                    break;
+                }
+            }
+            if (pFile)
+            {
+                ++pFile->lCount;
+                pFile->lFailed += bOk ? 0 : 1;
+                pFile->lCached += bCached ? 1 : 0;
+                pFile->llTicks += llTicks;
+            }
+            else
+            {
+                ++pTrace->lDroppedFiles;
+            }
+        }
+
+        ReleaseSRWLockExclusive(&s_TraceLock);
+    }
+
+    //Timing and caller of one hooked call.
+    class FCall
+    {
+    public:
+        FCall(const int iApi, void* const pReturn, void* const pReturnSlot)
+        :m_iApi(iApi)
+        ,m_dwCaller(reinterpret_cast<DWORD>(pReturn))
+        ,m_pStack(static_cast<const DWORD*>(pReturnSlot) + 1)
+        {
+            QueryPerformanceCounter(&m_liStart);
+        }
+
+        //Leaves GetLastError() as it was.
+        void Done(const bool bOk, const wchar_t* const pszName, const bool bCached = false) const
+        {
+            if (!s_bTrace)
+            {
+                return;
+            }
+            const DWORD dwError = GetLastError();
+            LARGE_INTEGER liEnd;
+            QueryPerformanceCounter(&liEnd);
+            Record(m_iApi, bOk, bCached, liEnd.QuadPart - m_liStart.QuadPart, pszName, m_dwCaller, m_pStack);
+            SetLastError(dwError);
+        }
+
+    private:
+        const int m_iApi;
+        const DWORD m_dwCaller;
+        const DWORD* const m_pStack;
+        LARGE_INTEGER m_liStart;
+    };
+
+    // ---- path cache use ----
+
+    //ANSI path -> wide, the way the A file functions convert; null if it
+    //doesn't fit. Leaves GetLastError() as it was.
+    const wchar_t* Widen(const char* const pszName, wchar_t(&szWide)[MAX_PATH])
+    {
+        if (!pszName)
+        {
+            return nullptr;
+        }
+        const DWORD dwError = GetLastError();
+        const bool bOk = MultiByteToWideChar(AreFileApisANSI() ? CP_ACP : CP_OEMCP, 0, pszName, -1, szWide, MAX_PATH) > 0;
+        SetLastError(dwError);
+        return bOk ? szWide : nullptr;
+    }
+
+    //True, with the error the OS would report, when the cache knows the path doesn't exist.
+    bool KnownMissing(const wchar_t* const pszName, DWORD& dwError)
+    {
+        if (!s_bUseCache || !pszName)
+        {
+            return false;
+        }
+        switch (PathCache::Lookup(pszName).Kind)
+        {
+        case PathCache::EKind::NoFile:
+            dwError = ERROR_FILE_NOT_FOUND;
+            return true;
+        case PathCache::EKind::NoPath:
+            dwError = ERROR_PATH_NOT_FOUND;
+            return true;
+        default:
+            return false;
+        }
+    }
+
+    //Something at pszName (null: unknown) was created, changed or removed. Leaves GetLastError() as it was.
+    void Invalidate(const wchar_t* const pszName)
+    {
+        if (!s_bUseCache)
+        {
+            return;
+        }
+        const DWORD dwError = GetLastError();
+        if (pszName)
+        {
+            PathCache::Invalidate(pszName);
+        }
+        else
+        {
+            PathCache::InvalidateAll();
+        }
+        SetLastError(dwError);
+    }
+
+    DWORD s_dwCoreBase = 0; //Core.dll's image, to tell its package-DLL probes apart
+    DWORD s_dwCoreEnd = 0;
+
+    bool IsMissingFile(const wchar_t* const pszName)
+    {
+        const PathCache::EKind Kind = PathCache::Lookup(pszName).Kind;
+        return Kind == PathCache::EKind::NoFile || Kind == PathCache::EKind::NoPath;
+    }
+
+    //Core binds every package it loads to a native DLL of the same name,
+    //trying "<System>\<Package>", "<System>\<Package>.dll" and
+    //"_<System>\<Package>.dll" - the last one can never exist (a ':' past
+    //the drive letter). Most packages have no DLL, and each failed
+    //LoadLibrary is a search that costs Wine 10-80 ms on the tablet. Only
+    //Core's calls are answered, and only where the cache rules the file out.
+    bool KnownMissingModule(const wchar_t* const pszName, const void* const pReturn)
+    {
+        const DWORD dwCaller = reinterpret_cast<DWORD>(pReturn);
+        if (!s_bUseCache || !pszName || dwCaller < s_dwCoreBase || dwCaller >= s_dwCoreEnd)
+        {
+            return false;
+        }
+        const size_t iLen = wcslen(pszName);
+        if (iLen < 3 || iLen >= MAX_PATH - 4)
+        {
+            return false;
+        }
+        if (pszName[0] != L'\\' && wcschr(pszName + 2, L':') != nullptr)
+        {
+            return true; //Not a valid path at all
+        }
+        if (pszName[1] != L':' || pszName[2] != L'\\' || !IsMissingFile(pszName))
+        {
+            return false; //Relative names go through the DLL search path: left to the loader
+        }
+        //Without an extension the loader also tries <name>.dll
+        const wchar_t* const pszFile = wcsrchr(pszName, L'\\') + 1;
+        if (wcschr(pszFile, L'.') == nullptr)
+        {
+            wchar_t szDll[MAX_PATH];
+            swprintf_s(szDll, L"%s.dll", pszName);
+            return IsMissingFile(szDll);
+        }
+        return true;
+    }
+
+    bool IsReadOnlyOpen(const DWORD dwAccess, const DWORD dwDisposition, const DWORD dwFlags)
+    {
+        constexpr DWORD dwWriteAccess = GENERIC_WRITE | GENERIC_ALL | FILE_WRITE_DATA | FILE_APPEND_DATA | FILE_WRITE_EA
+            | FILE_WRITE_ATTRIBUTES | DELETE | WRITE_DAC | WRITE_OWNER;
+        return dwDisposition == OPEN_EXISTING && (dwAccess & dwWriteAccess) == 0 && (dwFlags & FILE_FLAG_DELETE_ON_CLOSE) == 0;
+    }
