diff --git a/launcher/src/PathCache.cpp b/launcher/src/PathCache.cpp
new file mode 100644
index 0000000..6df7ee2
--- /dev/null
+++ b/launcher/src/PathCache.cpp
@@ -0,0 +1,448 @@
+#include "stdafx.h"
+#include "PathCache.h"
+#include "Misc.h"
+
+#include <new>
+
+#ifndef FIND_FIRST_EX_LARGE_FETCH
+#define FIND_FIRST_EX_LARGE_FETCH 0x00000002
+#endif
+
+namespace
+{
+    HANDLE s_hHeap = nullptr;
+
+    //Allocator on the private heap: lookups come from any thread, and global
+    //operator new is the engine's GMalloc, which isn't thread-safe.
+    template <class T>
+    struct THeapAllocator
+    {
+        using value_type = T;
+
+        THeapAllocator() = default;
+        template <class U> THeapAllocator(const THeapAllocator<U>&) noexcept {}
+
+        T* allocate(const size_t n)
+        {
+            void* const p = HeapAlloc(s_hHeap, 0, n * sizeof(T));
+            if (!p)
+            {
+                throw std::bad_alloc();
+            }
+            return static_cast<T*>(p);
+        }
+
+        void deallocate(T* const p, size_t) noexcept
+        {
+            HeapFree(s_hHeap, 0, p);
+        }
+
+        template <class U> bool operator==(const THeapAllocator<U>&) const noexcept { return true; }
+        template <class U> bool operator!=(const THeapAllocator<U>&) const noexcept { return false; }
+    };
+
+    using FKey = std::basic_string<wchar_t, std::char_traits<wchar_t>, THeapAllocator<wchar_t>>;
+
+    struct FKeyHash
+    {
+        size_t operator()(const FKey& Key) const noexcept
+        {
+            size_t h = 2166136261u; //FNV-1a
+            for (const wchar_t c : Key)
+            {
+                h = (h ^ c) * 16777619u;
+            }
+            return h;
+        }
+    };
+
+    template <class V>
+    using TKeyMap = std::unordered_map<FKey, V, FKeyHash, std::equal_to<FKey>, THeapAllocator<std::pair<const FKey, V>>>;
+
+    struct FEntry
+    {
+        FKey Name;          //As on disk
+        INT iSize;          //-1 for directories
+        bool bDirectory;
+    };
+
+    struct FListing
+    {
+        bool bMissing = false;      //The directory doesn't exist
+        TKeyMap<FEntry> Entries;    //Upper-cased name -> entry
+    };
+
+    struct FState
+    {
+        TKeyMap<FListing> Listings;                         //Upper-cased full directory path with trailing backslash -> listing
+        FKey Root;                                          //Upper-cased game directory with trailing backslash
+        std::vector<FKey, THeapAllocator<FKey>> Excluded;   //Same form; never cached
+    };
+
+    volatile bool s_bEnabled = false;
+    SRWLOCK s_Lock = SRWLOCK_INIT;
+    FState* s_pState = nullptr; //Never freed: hooks on other threads may still be looking
+
+    //Set while this thread holds s_Lock. A hooked file call made from inside
+    //(the directory listing itself) must not come back in: SRW locks aren't
+    //recursive.
+    thread_local bool t_bBusy = false;
+
+    //Counters since the previous ReportStats; guarded by s_Lock
+    LONG s_lLookups = 0;
+    LONG s_lAnswered = 0;
+    LONG s_lMissing = 0;
+    LONG s_lListings = 0;
+    LONG s_lInvalidations = 0;
+    LONGLONG s_llListingTicks = 0;
+
+    class FScopedLock
+    {
+    public:
+        FScopedLock()
+        {
+            AcquireSRWLockExclusive(&s_Lock);
+            t_bBusy = true;
+        }
+
+        ~FScopedLock()
+        {
+            t_bBusy = false;
+            ReleaseSRWLockExclusive(&s_Lock);
+        }
+
+        FScopedLock(const FScopedLock&) = delete;
+        FScopedLock& operator=(const FScopedLock&) = delete;
+    };
+
+    FKey MakeKey(const wchar_t* const p, const size_t n)
+    {
+        FKey Key(p, n);
+        if (n)
+        {
+            CharUpperBuffW(&Key[0], static_cast<DWORD>(n));
+        }
+        return Key;
+    }
+
+    bool StartsWith(const FKey& s, const FKey& Prefix)
+    {
+        return s.size() >= Prefix.size() && s.compare(0, Prefix.size(), Prefix) == 0;
+    }
+
+    //Upper-cased full path of pszBase\pszRelative with a trailing backslash; empty on failure.
+    FKey FullDirKey(const wchar_t* const pszBase, const wchar_t* const pszRelative)
+    {
+        wchar_t szCombined[MAX_PATH];
+        wchar_t szFull[MAX_PATH];
+        if (!PathCombine(szCombined, pszBase, pszRelative))
+        {
+            return FKey();
+        }
+        const DWORD dwLen = GetFullPathNameW(szCombined, MAX_PATH - 1, szFull, nullptr);
+        if (dwLen == 0 || dwLen >= MAX_PATH - 1)
+        {
+            return FKey();
+        }
+        FKey Key = MakeKey(szFull, dwLen);
+        if (Key.back() != L'\\')
+        {
+            Key += L'\\';
+        }
+        return Key;
+    }
+
+    //Full path of pszPath and where its last component starts. False for
+    //what the cache leaves to the OS: wildcards, devices and UNC paths, 8.3
+    //aliases ('~'), stream names, over-long paths, paths ending in '\'.
+    bool Resolve(const wchar_t* const pszPath, wchar_t(&szFull)[MAX_PATH], size_t& iNameAt)
+    {
+        if (!pszPath || !*pszPath || wcspbrk(pszPath, L"*?<>|\"~") != nullptr)
+        {
+            return false;
+        }
+        wchar_t* pszName = nullptr;
+        const DWORD dwLen = GetFullPathNameW(pszPath, MAX_PATH, szFull, &pszName);
+        if (dwLen == 0 || dwLen >= MAX_PATH || !pszName || !*pszName)
+        {
+            return false;
+        }
+        if (szFull[1] != L':' || szFull[2] != L'\\' || wcschr(szFull + 2, L':') != nullptr)
+        {
+            return false;
+        }
+        iNameAt = static_cast<size_t>(pszName - szFull);
+        return true;
+    }
+
+    bool IsCached(const FKey& DirKey)
+    {
+        if (!StartsWith(DirKey, s_pState->Root))
+        {
+            return false;
+        }
+        for (const FKey& Excluded : s_pState->Excluded)
+        {
+            if (StartsWith(DirKey, Excluded))
+            {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    //The listing of pszDir (full path, iDirLen chars including the trailing
+    //backslash), made now if there is none yet. Null if the directory can't
+    //be listed. Needs s_Lock.
+    const FListing* GetListing(const wchar_t* const pszDir, const size_t iDirLen, const FKey& DirKey)
+    {
+        const auto It = s_pState->Listings.find(DirKey);
+        if (It != s_pState->Listings.end())
+        {
+            return &It->second;
+        }
+
+        wchar_t szSpec[MAX_PATH + 2];
+        wmemcpy(szSpec, pszDir, iDirLen);
+        szSpec[iDirLen] = L'*';
+        szSpec[iDirLen + 1] = L'\0';
+
+        LARGE_INTEGER liStart, liEnd;
+        QueryPerformanceCounter(&liStart);
+        FListing Listing;
+        WIN32_FIND_DATAW Data;
+        const HANDLE hFind = FindFirstFileExW(szSpec, FindExInfoBasic, &Data, FindExSearchNameMatch, nullptr, FIND_FIRST_EX_LARGE_FETCH);
+        if (hFind == INVALID_HANDLE_VALUE)
+        {
+            const DWORD dwError = GetLastError();
+            if (dwError == ERROR_PATH_NOT_FOUND || dwError == ERROR_DIRECTORY || dwError == ERROR_INVALID_NAME)
+            {
+                Listing.bMissing = true;
+            }
+            else if (dwError != ERROR_FILE_NOT_FOUND) //"Not found" is an existing but empty directory
+            {
+                return nullptr; //E.g. access denied: leave it to the OS
+            }
+        }
+        else
+        {
+            do
+            {
+                if (wcscmp(Data.cFileName, L".") == 0 || wcscmp(Data.cFileName, L"..") == 0)
+                {
+                    continue;
+                }
+                const size_t iLen = wcslen(Data.cFileName);
+                const bool bDirectory = (Data.dwFileAttributes & FILE_ATTRIBUTE_DIRECTORY) != 0;
+                Listing.Entries.emplace(MakeKey(Data.cFileName, iLen), FEntry{ FKey(Data.cFileName, iLen), bDirectory ? -1 : static_cast<INT>(Data.nFileSizeLow), bDirectory });
+            } while (FindNextFileW(hFind, &Data));
+            const bool bComplete = GetLastError() == ERROR_NO_MORE_FILES;
+            FindClose(hFind);
+            if (!bComplete)
+            {
+                return nullptr; //A partial listing would report the rest as missing
+            }
+        }
+        QueryPerformanceCounter(&liEnd);
+        s_llListingTicks += liEnd.QuadPart - liStart.QuadPart;
+        ++s_lListings;
+        return &s_pState->Listings.emplace(DirKey, std::move(Listing)).first->second;
+    }
+}
+
+void PathCache::ReadConfig()
+{
+    assert(GConfig);
+    assert(GSys);
+    UBOOL bEnabled = TRUE;
+    GConfig->GetBool(PROJECTNAME, L"PathCache", bEnabled);
+    if (!bEnabled)
+    {
+        s_bEnabled = false;
+        GLog->Log(L"Path cache: off.");
+        return;
+    }
+
+    if (!s_pState)
+    {
+        s_hHeap = HeapCreate(0, 0, 0);
+        void* const pMem = s_hHeap ? HeapAlloc(s_hHeap, 0, sizeof(FState)) : nullptr;
+        if (!pMem)
+        {
+            GLog->Log(L"Path cache: off (no heap).");
+            return;
+        }
+        s_pState = new(pMem) FState();
+    }
+
+    wchar_t szSystem[MAX_PATH];
+    Misc::GetGameSystemDir(szSystem);
+    {
+        FScopedLock Lock;
+        s_pState->Listings.clear();
+        s_pState->Excluded.clear();
+        s_pState->Root = FullDirKey(szSystem, L"..");
+        for (const FString* const pPath : { &GSys->SavePath, &GSys->CachePath })
+        {
+            if (pPath->Len() > 0)
+            {
+                FKey Key = FullDirKey(szSystem, **pPath);
+                if (!Key.empty())
+                {
+                    s_pState->Excluded.push_back(std::move(Key));
+                }
+            }
+        }
+    }
+    s_bEnabled = !s_pState->Root.empty();
+    GLog->Logf(L"Path cache: %s for '%s' (not cached: '%s', '%s').", s_bEnabled ? L"on" : L"off",
+        s_pState->Root.c_str(),
+        s_pState->Excluded.size() > 0 ? s_pState->Excluded[0].c_str() : L"",
+        s_pState->Excluded.size() > 1 ? s_pState->Excluded[1].c_str() : L"");
+}
+
+bool PathCache::Enabled()
+{
+    return s_bEnabled;
+}
+
+void PathCache::Disable()
+{
+    s_bEnabled = false;
+}
+
+PathCache::FInfo PathCache::Lookup(const wchar_t* const pszPath, wchar_t* const pszActual)
+{
+    FInfo Info;
+    if (!s_bEnabled || t_bBusy)
+    {
+        return Info;
+    }
+    wchar_t szFull[MAX_PATH];
+    size_t iNameAt;
+    if (!Resolve(pszPath, szFull, iNameAt))
+    {
+        return Info;
+    }
+    const FKey DirKey = MakeKey(szFull, iNameAt);
+    if (!StartsWith(DirKey, s_pState->Root)) //Root only changes in ReadConfig
+    {
+        return Info;
+    }
+    const FKey NameKey = MakeKey(szFull + iNameAt, wcslen(szFull + iNameAt));
+
+    FScopedLock Lock;
+    ++s_lLookups;
+    if (!IsCached(DirKey))
+    {
+        return Info;
+    }
+    const FListing* const pListing = GetListing(szFull, iNameAt, DirKey);
+    if (!pListing)
+    {
+        return Info;
+    }
+    ++s_lAnswered;
+    if (pListing->bMissing)
+    {
+        ++s_lMissing;
+        Info.Kind = EKind::NoPath;
+        return Info;
+    }
+    const auto It = pListing->Entries.find(NameKey);
+    if (It == pListing->Entries.cend())
+    {
+        ++s_lMissing;
+        Info.Kind = EKind::NoFile;
+        return Info;
+    }
+    Info.Kind = It->second.bDirectory ? EKind::Directory : EKind::File;
+    Info.iSize = It->second.iSize;
+    if (pszActual)
+    {
+        wmemcpy(pszActual, szFull, iNameAt);
+        wcsncpy_s(pszActual + iNameAt, MAX_PATH - iNameAt, It->second.Name.c_str(), _TRUNCATE);
+    }
+    return Info;
+}
+
+void PathCache::Invalidate(const wchar_t* const pszPath)
+{
+    if (!s_bEnabled || t_bBusy)
+    {
+        return;
+    }
+    wchar_t szFull[MAX_PATH];
+    const DWORD dwLen = (pszPath && *pszPath) ? GetFullPathNameW(pszPath, MAX_PATH, szFull, nullptr) : 0;
+    if (dwLen == 0 || dwLen >= MAX_PATH)
+    {
+        InvalidateAll(); //Can't tell what changed
+        return;
+    }
+
+    //Treat the path as an entry of its parent, also when given as "dir\"
+    size_t iLen = dwLen;
+    while (iLen > 3 && szFull[iLen - 1] == L'\\')
+    {
+        szFull[--iLen] = L'\0';
+    }
+    const wchar_t* const pszLast = wcsrchr(szFull, L'\\');
+    if (!pszLast)
+    {
+        InvalidateAll();
+        return;
+    }
+    const FKey DirKey = MakeKey(szFull, static_cast<size_t>(pszLast - szFull) + 1);
+    if (!StartsWith(DirKey, s_pState->Root))
+    {
+        return; //Nothing outside the game directory is cached
+    }
+    FKey SelfKey = MakeKey(szFull, iLen);
+    SelfKey += L'\\';
+
+    FScopedLock Lock;
+    ++s_lInvalidations;
+    s_pState->Listings.erase(DirKey);
+    for (auto It = s_pState->Listings.begin(); It != s_pState->Listings.end();)
+    {
+        It = StartsWith(It->first, SelfKey) ? s_pState->Listings.erase(It) : std::next(It);
+    }
+}
+
+void PathCache::InvalidateAll()
+{
+    if (!s_bEnabled || t_bBusy)
+    {
+        return;
+    }
+    FScopedLock Lock;
+    ++s_lInvalidations;
+    s_pState->Listings.clear();
+}
+
+void PathCache::ReportStats()
+{
+    if (!s_pState)
+    {
+        return;
+    }
+    LONG lLookups, lAnswered, lMissing, lListings, lInvalidations;
+    LONGLONG llListingTicks;
+    size_t nDirs;
+    {
+        FScopedLock Lock;
+        lLookups = s_lLookups;
+        lAnswered = s_lAnswered;
+        lMissing = s_lMissing;
+        lListings = s_lListings;
+        lInvalidations = s_lInvalidations;
+        llListingTicks = s_llListingTicks;
+        nDirs = s_pState->Listings.size();
+        s_lLookups = s_lAnswered = s_lMissing = s_lListings = s_lInvalidations = 0;
+        s_llListingTicks = 0;
+    }
+    LARGE_INTEGER liFreq;
+    QueryPerformanceFrequency(&liFreq);
+    GLog->Logf(L"Path cache: %i lookups, %i answered (%i not found); %i directory listings (%.0f ms), %i invalidations; %i directories cached.",
+        lLookups, lAnswered, lMissing, lListings, llListingTicks * 1000.0 / liFreq.QuadPart, lInvalidations, static_cast<INT>(nDirs));
+}
diff --git a/launcher/src/PathCache.h b/launcher/src/PathCache.h
new file mode 100644
index 0000000..e94d63c
--- /dev/null
+++ b/launcher/src/PathCache.h
@@ -0,0 +1,56 @@
+#pragma once
+
+// Directory listings of the game directory, for answering "does this file
+// exist, and how big is it" without asking the OS each time.
+//
+// Under Wine on Android's case-sensitive FUSE storage every lookup of a file
+// that doesn't exist makes Wine scan the whole directory for a
+// case-insensitive match - milliseconds each - and the game makes thousands
+// of them per map load: the engine probes every search path for each package
+// and localization file (appFindPackageFile, FConfigCacheIni::Find via
+// GFileManager->FileSize), and D3D10Drv looks for replacement .dds/.flags
+// files for every texture it uploads. Level and savegame loads on the tablet
+// spent minutes in failed CreateFileW calls.
+//
+// Each directory below the game directory is listed once and lookups are
+// answered from the listing. The save and cache directories are never
+// cached. Whatever creates, writes, moves or deletes files must call
+// Invalidate - FileHooks does for the whole process - and every map load
+// starts afresh (InvalidateAll).
+//
+// Thread-safe; keeps its data on a private heap, as the engine's allocator
+// isn't thread-safe. [DeusExe] PathCache=False disables it.
+namespace PathCache
+{
+    enum class EKind
+    {
+        Unknown,    // not answered: disabled, outside the game directory, excluded, odd name
+        NoFile,     // the directory exists, the file doesn't
+        NoPath,     // the directory doesn't exist
+        File,
+        Directory,
+    };
+
+    struct FInfo
+    {
+        EKind Kind = EKind::Unknown;
+        INT iSize = -1;     // files only
+    };
+
+    // Needs GConfig and GSys: call on the main thread when the game starts.
+    void ReadConfig();
+    bool Enabled();
+    void Disable();
+
+    // pszActual (optional, MAX_PATH chars) receives the full path with the
+    // last component spelled as on disk (File and Directory only).
+    FInfo Lookup(const wchar_t* pszPath, wchar_t* pszActual = nullptr);
+
+    // Forget the directory holding pszPath, and pszPath itself (with its
+    // subdirectories) in case it is or was a directory.
+    void Invalidate(const wchar_t* pszPath);
+    void InvalidateAll();
+
+    // Logs the counters gathered since the previous call. Main thread.
+    void ReportStats();
+}
diff --git a/launcher/src/Symbols.cpp b/launcher/src/Symbols.cpp
new file mode 100644
index 0000000..76d6984
--- /dev/null
+++ b/launcher/src/Symbols.cpp
@@ -0,0 +1,120 @@
+#include "stdafx.h"
+#include "Symbols.h"
+
+#include <psapi.h>
+#pragma comment(lib, "psapi.lib")
+
+namespace
+{
+    std::wstring Narrow2Wide(const std::string& s)
+    {
+        return std::wstring(s.begin(), s.end());
+    }
+}
+
+std::vector<Symbols::ExportTable> Symbols::BuildExportTables()
+{
+    std::vector<ExportTable> tables;
+    HMODULE hMods[512];
+    DWORD cbNeeded = 0;
+    if (!EnumProcessModules(GetCurrentProcess(), hMods, sizeof(hMods), &cbNeeded))
+        return tables;
+    const int iCount = std::min<int>(cbNeeded / sizeof(HMODULE), _countof(hMods));
+    for (int i = 0; i < iCount; ++i)
+    {
+        ExportTable t;
+        MODULEINFO mi = {};
+        if (!GetModuleInformation(GetCurrentProcess(), hMods[i], &mi, sizeof(mi)))
+            continue;
+        wchar_t szName[MAX_PATH] = L"?";
+        GetModuleBaseNameW(GetCurrentProcess(), hMods[i], szName, MAX_PATH);
+        t.Module = szName;
+        t.Base = reinterpret_cast<DWORD>(mi.lpBaseOfDll);
+        t.End = t.Base + mi.SizeOfImage;
+        const BYTE* const pBase = reinterpret_cast<const BYTE*>(mi.lpBaseOfDll);
+        const auto* const pDos = reinterpret_cast<const IMAGE_DOS_HEADER*>(pBase);
+        if (pDos->e_magic == IMAGE_DOS_SIGNATURE)
+        {
+            const auto* const pNt = reinterpret_cast<const IMAGE_NT_HEADERS32*>(pBase + pDos->e_lfanew);
+            const IMAGE_DATA_DIRECTORY& dir = pNt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_EXPORT];
+            if (pNt->Signature == IMAGE_NT_SIGNATURE && dir.VirtualAddress && dir.Size)
+            {
+                const auto* const pExp = reinterpret_cast<const IMAGE_EXPORT_DIRECTORY*>(pBase + dir.VirtualAddress);
+                const DWORD* const pFuncs = reinterpret_cast<const DWORD*>(pBase + pExp->AddressOfFunctions);
+                const DWORD* const pNames = reinterpret_cast<const DWORD*>(pBase + pExp->AddressOfNames);
+                const WORD* const pOrds = reinterpret_cast<const WORD*>(pBase + pExp->AddressOfNameOrdinals);
+                std::vector<bool> named(pExp->NumberOfFunctions, false);
+                for (DWORD n = 0; n < pExp->NumberOfNames; ++n)
+                {
+                    const WORD ord = pOrds[n];
+                    if (ord >= pExp->NumberOfFunctions)
+                        continue;
+                    const DWORD rva = pFuncs[ord];
+                    if (rva >= dir.VirtualAddress && rva < dir.VirtualAddress + dir.Size)
+                        continue;   // forwarder
+                    t.Exports.emplace_back(rva, reinterpret_cast<const char*>(pBase + pNames[n]));
+                    named[ord] = true;
+                }
+                for (DWORD o = 0; o < pExp->NumberOfFunctions; ++o)
+                {
+                    const DWORD rva = pFuncs[o];
+                    if (named[o] || !rva || (rva >= dir.VirtualAddress && rva < dir.VirtualAddress + dir.Size))
+                        continue;
+                    t.Exports.emplace_back(rva, "#" + std::to_string(o + pExp->Base));
+                }
+                std::sort(t.Exports.begin(), t.Exports.end());
+            }
+        }
+        tables.push_back(std::move(t));
+    }
+    return tables;
+}
+
+// "Module+0x1a2b (Export+0x1a)" (export name shortened for C++ decorated names)
+std::wstring Symbols::Symbolize(const std::vector<ExportTable>& tables, DWORD dwAddr, bool bModuleOnly)
+{
+    for (const ExportTable& t : tables)
+    {
+        if (dwAddr < t.Base || dwAddr >= t.End)
+            continue;
+        if (bModuleOnly)
+            return t.Module;
+        const DWORD rva = dwAddr - t.Base;
+        auto it = std::upper_bound(t.Exports.begin(), t.Exports.end(), std::make_pair(rva, std::string("\xff")));
+        wchar_t sz[512];
+        if (it == t.Exports.begin())
+        {
+            swprintf_s(sz, L"%s+0x%x", t.Module.c_str(), rva);
+            return sz;
+        }
+        --it;
+        std::string name = it->second;
+        if (name.size() > 60)
+            name = name.substr(0, 60) + "...";
+        swprintf_s(sz, L"%s+0x%x (%s+0x%x)", t.Module.c_str(), rva, Narrow2Wide(name).c_str(), rva - it->first);
+        return sz;
+    }
+    wchar_t sz[32];
+    swprintf_s(sz, L"0x%08x", dwAddr);
+    return sz;
+}
+
+bool Symbols::IsSystemModule(const std::wstring& module)
+{
+    static const wchar_t* const s_aSystem[] = {
+        L"ntdll.dll", L"kernel32.dll", L"kernelbase.dll", L"user32.dll", L"win32u.dll", L"gdi32.dll",
+        L"msvcrt.dll", L"ucrtbase.dll", L"msvcp140.dll", L"vcruntime140.dll", L"msvcr100.dll", L"msvcp100.dll",
+        L"msvcr71.dll", L"msvcr80.dll", L"msvcr90.dll", L"winmm.dll", L"dsound.dll",
+        L"advapi32.dll", L"sechost.dll", L"rpcrt4.dll", L"combase.dll", L"ole32.dll", L"imm32.dll",
+        L"shell32.dll", L"shlwapi.dll", L"comctl32.dll", L"uxtheme.dll", L"dxgi.dll", L"d3d10.dll",
+        L"d3d10_1.dll", L"d3d11.dll", L"d3d10core.dll", L"d3dx10_43.dll", L"d3dcompiler_43.dll", L"d3dcompiler_47.dll",
+        L"winevulkan.dll", L"vulkan-1.dll", L"dinput.dll",
+        L"dinput8.dll", L"xinput1_3.dll", L"hid.dll", L"setupapi.dll", L"psapi.dll", L"version.dll",
+    };
+    for (const wchar_t* p : s_aSystem)
+    {
+        if (_wcsicmp(module.c_str(), p) == 0)
+            return true;
+    }
+    return false;
+}
diff --git a/launcher/src/Symbols.h b/launcher/src/Symbols.h
new file mode 100644
index 0000000..480cb7f
--- /dev/null
+++ b/launcher/src/Symbols.h
@@ -0,0 +1,26 @@
+#pragma once
+
+// Address -> "Module+0xRVA (NearestExport+0xOffset)" from the loaded
+// modules' export tables. The diagnostics (LoadProfiler, FileHooks) have no
+// debug symbols for the game's DLLs, and the nearest export plus the RVA is
+// enough to find a function in a disassembly.
+namespace Symbols
+{
+    struct ExportTable
+    {
+        std::wstring Module;
+        DWORD Base = 0;
+        DWORD End = 0;
+        std::vector<std::pair<DWORD, std::string>> Exports;   // sorted by RVA
+    };
+
+    // Snapshot of the modules loaded now. Allocates through the engine's
+    // allocator: main thread only.
+    std::vector<ExportTable> BuildExportTables();
+
+    std::wstring Symbolize(const std::vector<ExportTable>& Tables, DWORD dwAddr, bool bModuleOnly = false);
+
+    // OS, C runtime and graphics-stack modules: skipped when looking for the
+    // game frame responsible for a call.
+    bool IsSystemModule(const std::wstring& Module);
+}
