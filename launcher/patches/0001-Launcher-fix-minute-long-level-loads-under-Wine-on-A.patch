+    // ---- import patching ----
+
+    DWORD ImageSize(const HMODULE hModule)
+    {
+        __try
+        {
+            const BYTE* const pBase = reinterpret_cast<const BYTE*>(hModule);
+            const IMAGE_DOS_HEADER* const pDos = reinterpret_cast<const IMAGE_DOS_HEADER*>(pBase);
+            if (pDos->e_magic != IMAGE_DOS_SIGNATURE)
+            {
+                return 0;
+            }
+            const IMAGE_NT_HEADERS32* const pNt = reinterpret_cast<const IMAGE_NT_HEADERS32*>(pBase + pDos->e_lfanew);
+            return pNt->Signature == IMAGE_NT_SIGNATURE ? pNt->OptionalHeader.SizeOfImage : 0;
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            return 0;
+        }
+    }
+
+    //Points every import slot holding a target at its hook (pfnFind == null),
+    //or counts the slots holding pfnFind. SEH-guarded, so no C++ objects here.
+    int WalkImports(BYTE* const pBase, const void* const pfnFind)
+    {
+        __try
+        {
+            const IMAGE_DOS_HEADER* const pDos = reinterpret_cast<const IMAGE_DOS_HEADER*>(pBase);
+            if (pDos->e_magic != IMAGE_DOS_SIGNATURE)
+            {
+                return 0;
+            }
+            const IMAGE_NT_HEADERS32* const pNt = reinterpret_cast<const IMAGE_NT_HEADERS32*>(pBase + pDos->e_lfanew);
+            if (pNt->Signature != IMAGE_NT_SIGNATURE || pNt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR32_MAGIC)
+            {
+                return 0;
+            }
+            const IMAGE_DATA_DIRECTORY& Dir = pNt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT];
+            if (!Dir.VirtualAddress || !Dir.Size)
+            {
+                return 0;
+            }
+            int iCount = 0;
+            for (const IMAGE_IMPORT_DESCRIPTOR* pDesc = reinterpret_cast<const IMAGE_IMPORT_DESCRIPTOR*>(pBase + Dir.VirtualAddress); pDesc->Name; ++pDesc)
+            {
+                if (!pDesc->FirstThunk)
+                {
+                    continue;
+                }
+                for (IMAGE_THUNK_DATA32* pThunk = reinterpret_cast<IMAGE_THUNK_DATA32*>(pBase + pDesc->FirstThunk); pThunk->u1.Function; ++pThunk)
+                {
+                    void* const pfn = reinterpret_cast<void*>(static_cast<ULONG_PTR>(pThunk->u1.Function));
+                    if (pfnFind)
+                    {
+                        iCount += pfn == pfnFind ? 1 : 0;
+                        continue;
+                    }
+                    for (const FTarget& Target : s_aTargets)
+                    {
+                        if (!Target.pfnOriginal || (pfn != Target.pfnOriginal && pfn != Target.pfnAlt))
+                        {
+                            continue;
+                        }
+                        DWORD dwOld;
+                        if (VirtualProtect(&pThunk->u1.Function, sizeof(pThunk->u1.Function), PAGE_EXECUTE_READWRITE, &dwOld))
+                        {
+                            pThunk->u1.Function = reinterpret_cast<DWORD>(Target.pfnHook);
+                            VirtualProtect(&pThunk->u1.Function, sizeof(pThunk->u1.Function), dwOld, &dwOld);
+                            ++iCount;
+                        }
+                        break;
+                    }
+                }
+            }
+            return iCount;
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            return 0;
+        }
+    }
+
+    void UpdateModuleTable(const HMODULE* const ahModules, const int iCount)
+    {
+        FModuleTable Table;
+        Table.iCount = 0;
+        for (int i = 0; i < iCount && Table.iCount < static_cast<int>(_countof(Table.aRanges)); ++i)
+        {
+            const DWORD dwSize = ImageSize(ahModules[i]);
+            if (dwSize)
+            {
+                const DWORD dwBase = reinterpret_cast<DWORD>(ahModules[i]);
+                Table.aRanges[Table.iCount++] = { dwBase, dwBase + dwSize };
+            }
+        }
+        std::sort(Table.aRanges, Table.aRanges + Table.iCount, [](const FModuleRange& a, const FModuleRange& b) { return a.dwBase < b.dwBase; });
+
+        const FModuleTable* const pOld = s_pModules;
+        if (pOld && pOld->iCount == Table.iCount && memcmp(pOld->aRanges, Table.aRanges, Table.iCount * sizeof(FModuleRange)) == 0)
+        {
+            return;
+        }
+        FModuleTable* const pNew = static_cast<FModuleTable*>(VirtualAlloc(nullptr, sizeof(FModuleTable), MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+        if (pNew)
+        {
+            *pNew = Table;
+            InterlockedExchangePointer(reinterpret_cast<PVOID volatile*>(&s_pModules), pNew);
+        }
+    }
+
+    //Needs s_csPatch.
+    void PatchAllModules()
+    {
+        HMODULE ahModules[512];
+        DWORD cbNeeded = 0;
+        if (!EnumProcessModules(GetCurrentProcess(), ahModules, sizeof(ahModules), &cbNeeded))
+        {
+            return;
+        }
+        const int iCount = std::min<int>(cbNeeded / sizeof(HMODULE), _countof(ahModules));
+        UpdateModuleTable(ahModules, iCount);
+        for (int i = 0; i < iCount; ++i)
+        {
+            if (ahModules[i] != s_hKernel32 && ahModules[i] != s_hKernelBase && ahModules[i] != s_hNtdll)
+            {
+                s_lPatchedSlots += WalkImports(reinterpret_cast<BYTE*>(ahModules[i]), nullptr);
+            }
+        }
+    }
+
+    void RescanAfterLoad(const HMODULE hModule)
+    {
+        //Datafile/resource mappings (low bits set) aren't loaded modules
+        if (!hModule || (reinterpret_cast<UINT_PTR>(hModule) & 3) != 0)
+        {
+            return;
+        }
+        const FModuleTable* const pTable = s_pModules;
+        if (pTable && InModule(*pTable, reinterpret_cast<DWORD>(hModule)))
+        {
+            return; //Known already, so are its dependencies
+        }
+        const DWORD dwError = GetLastError();
+        EnterCriticalSection(&s_csPatch);
+        PatchAllModules();
+        LeaveCriticalSection(&s_csPatch);
+        SetLastError(dwError);
+    }
+
+    std::wstring ApiName(const int iApi)
+    {
+        const char* const psz = s_aTargets[iApi].pszName;
+        return std::wstring(psz, psz + strlen(psz));
+    }
+
+    struct FAggregate
+    {
+        LONG lCount = 0;
+        LONG lFailed = 0;
+        LONG lCached = 0;
+        LONGLONG llTicks = 0;
+        std::wstring Example;
+    };
+
+    void ReportTrace()
+    {
+        //Take the data and start over, then format without the lock. Allocate
+        //first: nothing that can throw may run while hooks on other threads
+        //wait for the lock.
+        std::vector<FApiStat> Apis(Api_Count);
+        std::vector<FCallerStat> Callers;
+        std::vector<FFileStat> Files;
+        Callers.reserve(MaxCallers);
+        Files.reserve(MaxFiles);
+        LONG lDroppedCallers, lDroppedFiles;
+        AcquireSRWLockExclusive(&s_TraceLock);
+        memcpy(Apis.data(), s_pTrace->aApis, sizeof(s_pTrace->aApis));
+        for (const FCallerStat& Caller : s_pTrace->aCallers)
+        {
+            if (Caller.bUsed)
+            {
+                Callers.push_back(Caller);
+            }
+        }
+        for (const FFileStat& File : s_pTrace->aFiles)
+        {
+            if (File.bUsed)
+            {
+                Files.push_back(File);
+            }
+        }
+        lDroppedCallers = s_pTrace->lDroppedCallers;
+        lDroppedFiles = s_pTrace->lDroppedFiles;
+        memset(s_pTrace, 0, sizeof(FTrace));
+        ReleaseSRWLockExclusive(&s_TraceLock);
+
+        const double dTicksPerSecond = static_cast<double>(s_liFreq.QuadPart);
+        LONG lTotal = 0;
+        LONG lCached = 0;
+        LONGLONG llTotalTicks = 0;
+        for (const FApiStat& Api : Apis)
+        {
+            lTotal += Api.lCount;
+            lCached += Api.lCached;
+            llTotalTicks += Api.llTicks;
+        }
+        GLog->Logf(L"File trace: %i calls, %.2f s in total; %i answered from the path cache.", lTotal, llTotalTicks / dTicksPerSecond, lCached);
+        if (lTotal == 0)
+        {
+            return;
+        }
+
+        std::vector<int> Order;
+        for (int i = 0; i < Api_Count; ++i)
+        {
+            if (Apis[i].lCount > 0)
+            {
+                Order.push_back(i);
+            }
+        }
+        std::sort(Order.begin(), Order.end(), [&Apis](const int a, const int b) { return Apis[a].llTicks > Apis[b].llTicks; });
+        for (const int i : Order)
+        {
+            const FApiStat& Api = Apis[i];
+            GLog->Logf(L"File trace:   %s: %i calls (%i failed, %i from cache), %.2f s, %.2f ms each.", ApiName(i).c_str(),
+                Api.lCount, Api.lFailed, Api.lCached, Api.llTicks / dTicksPerSecond, Api.llTicks * 1000.0 / dTicksPerSecond / Api.lCount);
+        }
+
+        //Callers, merged by what is shown: direct caller plus the next game frames
+        const std::vector<Symbols::ExportTable> Tables = Symbols::BuildExportTables();
+        std::unordered_map<std::wstring, FAggregate> ByChain;
+        for (const FCallerStat& Caller : Callers)
+        {
+            std::wstring Chain = ApiName(Caller.wApi) + L"  " + Symbols::Symbolize(Tables, Caller.aFrames[0]);
+            int iGameFrames = Symbols::IsSystemModule(Symbols::Symbolize(Tables, Caller.aFrames[0], true)) ? 0 : 1;
+            for (int f = 1; f < MaxFrames && Caller.aFrames[f] && iGameFrames < 4; ++f)
+            {
+                if (Symbols::IsSystemModule(Symbols::Symbolize(Tables, Caller.aFrames[f], true)))
+                {
+                    continue;
+                }
+                Chain += L" <- " + Symbols::Symbolize(Tables, Caller.aFrames[f]);
+                ++iGameFrames;
+            }
+            FAggregate& Aggregate = ByChain[Chain];
+            Aggregate.lCount += Caller.lCount;
+            Aggregate.lFailed += Caller.lFailed;
+            Aggregate.lCached += Caller.lCached;
+            Aggregate.llTicks += Caller.llTicks;
+            if (Aggregate.Example.empty())
+            {
+                Aggregate.Example = Caller.szExample;
+            }
+        }
+        std::vector<std::pair<std::wstring, FAggregate>> SortedChains(ByChain.begin(), ByChain.end());
+        std::sort(SortedChains.begin(), SortedChains.end(), [](const auto& a, const auto& b) { return a.second.llTicks > b.second.llTicks; });
+        GLog->Log(L"File trace: --- callers by time ---");
+        for (size_t i = 0; i < SortedChains.size() && i < 20; ++i)
+        {
+            const FAggregate& Aggregate = SortedChains[i].second;
+            GLog->Logf(L"File trace: %5.1f%% %7.2f s %6ix (%i failed, %i from cache)  %s  e.g. '%s'",
+                100.0 * Aggregate.llTicks / std::max<LONGLONG>(llTotalTicks, 1), Aggregate.llTicks / dTicksPerSecond,
+                Aggregate.lCount, Aggregate.lFailed, Aggregate.lCached, SortedChains[i].first.c_str(), Aggregate.Example.c_str());
+        }
+
+        std::sort(Files.begin(), Files.end(), [](const FFileStat& a, const FFileStat& b) { return a.llTicks > b.llTicks; });
+        GLog->Logf(L"File trace: --- files by time (%i distinct) ---", static_cast<INT>(Files.size()));
+        for (size_t i = 0; i < Files.size() && i < 25; ++i)
+        {
+            const FFileStat& File = Files[i];
+            GLog->Logf(L"File trace: %7.2f s %6ix (%i failed, %i from cache)  %s  '%s'", File.llTicks / dTicksPerSecond,
+                File.lCount, File.lFailed, File.lCached, ApiName(File.wApi).c_str(), File.szName);
+        }
+        if (lDroppedCallers || lDroppedFiles)
+        {
+            GLog->Logf(L"File trace: tables full, %i caller and %i file records dropped.", lDroppedCallers, lDroppedFiles);
+        }
+    }
+}
+
+void FileHooks::Install()
+{
+    if (s_bActive)
+    {
+        return;
+    }
+    UBOOL bTrace = FALSE; //Diagnostics only: a stack scan per hooked call
+    GConfig->GetBool(PROJECTNAME, L"FileTrace", bTrace);
+    s_bUseCache = PathCache::Enabled();
+    if (!bTrace && !s_bUseCache)
+    {
+        GLog->Log(L"File hooks: off.");
+        return;
+    }
+    if (bTrace && !s_pTrace)
+    {
+        s_pTrace = static_cast<FTrace*>(VirtualAlloc(nullptr, sizeof(FTrace), MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+    }
+    s_bTrace = bTrace && s_pTrace;
+    QueryPerformanceFrequency(&s_liFreq);
+
+    s_hKernel32 = GetModuleHandleW(L"kernel32.dll");
+    s_hKernelBase = GetModuleHandleW(L"kernelbase.dll");
+    s_hNtdll = GetModuleHandleW(L"ntdll.dll");
+
+    static const struct
+    {
+        const char* pszName;
+        void* pfnHook;
+    } s_aHooks[Api_Count] =
+    {
+        { "CreateFileW", reinterpret_cast<void*>(&Hook_CreateFileW) },
+        { "CreateFileA", reinterpret_cast<void*>(&Hook_CreateFileA) },
+        { "GetFileAttributesW", reinterpret_cast<void*>(&Hook_GetFileAttributesW) },
+        { "GetFileAttributesA", reinterpret_cast<void*>(&Hook_GetFileAttributesA) },
+        { "GetFileAttributesExW", reinterpret_cast<void*>(&Hook_GetFileAttributesExW) },
+        { "GetFileAttributesExA", reinterpret_cast<void*>(&Hook_GetFileAttributesExA) },
+        { "FindFirstFileW", reinterpret_cast<void*>(&Hook_FindFirstFileW) },
+        { "FindFirstFileA", reinterpret_cast<void*>(&Hook_FindFirstFileA) },
+        { "FindFirstFileExW", reinterpret_cast<void*>(&Hook_FindFirstFileExW) },
+        { "FindFirstFileExA", reinterpret_cast<void*>(&Hook_FindFirstFileExA) },
+        { "CopyFileW", reinterpret_cast<void*>(&Hook_CopyFileW) },
+        { "CopyFileA", reinterpret_cast<void*>(&Hook_CopyFileA) },
+        { "CopyFileExW", reinterpret_cast<void*>(&Hook_CopyFileExW) },
+        { "CopyFileExA", reinterpret_cast<void*>(&Hook_CopyFileExA) },
+        { "MoveFileW", reinterpret_cast<void*>(&Hook_MoveFileW) },
+        { "MoveFileA", reinterpret_cast<void*>(&Hook_MoveFileA) },
+        { "MoveFileExW", reinterpret_cast<void*>(&Hook_MoveFileExW) },
+        { "MoveFileExA", reinterpret_cast<void*>(&Hook_MoveFileExA) },
+        { "DeleteFileW", reinterpret_cast<void*>(&Hook_DeleteFileW) },
+        { "DeleteFileA", reinterpret_cast<void*>(&Hook_DeleteFileA) },
+        { "CreateDirectoryW", reinterpret_cast<void*>(&Hook_CreateDirectoryW) },
+        { "CreateDirectoryA", reinterpret_cast<void*>(&Hook_CreateDirectoryA) },
+        { "RemoveDirectoryW", reinterpret_cast<void*>(&Hook_RemoveDirectoryW) },
+        { "RemoveDirectoryA", reinterpret_cast<void*>(&Hook_RemoveDirectoryA) },
+        { "LoadLibraryW", reinterpret_cast<void*>(&Hook_LoadLibraryW) },
+        { "LoadLibraryA", reinterpret_cast<void*>(&Hook_LoadLibraryA) },
+        { "LoadLibraryExW", reinterpret_cast<void*>(&Hook_LoadLibraryExW) },
+        { "LoadLibraryExA", reinterpret_cast<void*>(&Hook_LoadLibraryExA) },
+    };
+    for (int i = 0; i < Api_Count; ++i)
+    {
+        FTarget& Target = s_aTargets[i];
+        Target.pszName = s_aHooks[i].pszName;
+        Target.pfnHook = s_aHooks[i].pfnHook;
+        void* const pfnKernel32 = s_hKernel32 ? reinterpret_cast<void*>(GetProcAddress(s_hKernel32, Target.pszName)) : nullptr;
+        void* const pfnKernelBase = s_hKernelBase ? reinterpret_cast<void*>(GetProcAddress(s_hKernelBase, Target.pszName)) : nullptr;
+        Target.pfnOriginal = pfnKernel32 ? pfnKernel32 : pfnKernelBase;
+        Target.pfnAlt = pfnKernelBase ? pfnKernelBase : pfnKernel32;
+    }
+
+    const HMODULE hCore = GetModuleHandleW(L"Core.dll");
+    s_dwCoreBase = reinterpret_cast<DWORD>(hCore);
+    s_dwCoreEnd = hCore ? s_dwCoreBase + ImageSize(hCore) : 0;
+
+    InitializeCriticalSection(&s_csPatch);
+    s_bActive = true;
+    EnterCriticalSection(&s_csPatch);
+    PatchAllModules();
+    LeaveCriticalSection(&s_csPatch);
+
+    //The cache is only safe while it sees every write. The file manager's
+    //writes go through this module's own imports; if those couldn't be
+    //patched, don't cache.
+    if (s_bUseCache && WalkImports(reinterpret_cast<BYTE*>(GetModuleHandleW(nullptr)), reinterpret_cast<const void*>(&Hook_CreateFileW)) == 0)
+    {
+        s_bUseCache = false;
+        PathCache::Disable();
+        GLog->Log(L"File hooks: own imports not patched; path cache disabled.");
+    }
+    GLog->Logf(L"File hooks: %i import slots patched; trace %s, path cache %s.", s_lPatchedSlots,
+        s_bTrace ? L"on" : L"off", s_bUseCache ? L"on" : L"off");
+}
+
+void FileHooks::Rescan()
+{
+    if (!s_bActive)
+    {
+        return;
+    }
+    EnterCriticalSection(&s_csPatch);
+    PatchAllModules();
+    LeaveCriticalSection(&s_csPatch);
+}
+
+void FileHooks::Report()
+{
+    if (s_bActive && s_bTrace && s_pTrace)
+    {
+        ReportTrace();
+    }
+    PathCache::ReportStats();
+}
+
+void FileHooks::Shutdown()
+{
+    s_bUseCache = false;
+    s_bTrace = false;
+    s_bActive = false;
+    PathCache::Disable();
+}
diff --git a/launcher/src/FileHooks.h b/launcher/src/FileHooks.h
new file mode 100644
index 0000000..d58dea5
--- /dev/null
+++ b/launcher/src/FileHooks.h
@@ -0,0 +1,30 @@
+#pragma once
+
+// Import-table hooks on the process's file-system calls - CreateFile,
+// GetFileAttributes(Ex), FindFirstFile(Ex), CopyFile, MoveFile, DeleteFile,
+// Create/RemoveDirectory - in every loaded module (LoadLibrary is hooked too,
+// so modules loaded later get patched as they come in).
+//
+// - Read-only opens and attribute queries of files that PathCache knows
+//   don't exist fail right away with the error the OS would give, instead of
+//   costing Wine a directory scan each. So do Core.dll's attempts to load a
+//   native DLL for every package it binds, where the DLL is known to be
+//   missing. Every call that creates, writes, moves or deletes something
+//   invalidates the cache.
+// - [DeusExe] FileTrace=True (off by default) counts and times all of these calls;
+//   Report() logs the totals, the most expensive callers (direct caller plus
+//   the next return addresses on the stack) and files.
+namespace FileHooks
+{
+    // Main thread, after PathCache::ReadConfig.
+    void Install();
+
+    // Patches modules loaded since the previous scan.
+    void Rescan();
+
+    // Logs what was gathered since the previous call (and the path cache's counters).
+    void Report();
+
+    // Back to plain pass-through, before the engine shuts down.
+    void Shutdown();
+}
