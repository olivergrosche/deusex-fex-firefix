+    HANDLE WINAPI Hook_CreateFileW(LPCWSTR pszName, DWORD dwAccess, DWORD dwShare, LPSECURITY_ATTRIBUTES pSecurity, DWORD dwDisposition, DWORD dwFlags, HANDLE hTemplate)
+    {
+        const auto pfn = Original<decltype(&CreateFileW)>(Api_CreateFileW);
+        if (!s_bActive)
+        {
+            return pfn(pszName, dwAccess, dwShare, pSecurity, dwDisposition, dwFlags, hTemplate);
+        }
+        const FCall Call(Api_CreateFileW, _ReturnAddress(), _AddressOfReturnAddress());
+        const bool bReadOnly = IsReadOnlyOpen(dwAccess, dwDisposition, dwFlags);
+        DWORD dwError;
+        if (bReadOnly && KnownMissing(pszName, dwError))
+        {
+            Call.Done(false, pszName, true);
+            SetLastError(dwError);
+            return INVALID_HANDLE_VALUE;
+        }
+        const HANDLE hFile = pfn(pszName, dwAccess, dwShare, pSecurity, dwDisposition, dwFlags, hTemplate);
+        if (!bReadOnly)
+        {
+            Invalidate(pszName);
+        }
+        Call.Done(hFile != INVALID_HANDLE_VALUE, pszName);
+        return hFile;
+    }
