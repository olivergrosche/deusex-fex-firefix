diff --git a/launcher/src/LoadProfiler.cpp b/launcher/src/LoadProfiler.cpp
new file mode 100644
index 0000000..c31e11c
--- /dev/null
+++ b/launcher/src/LoadProfiler.cpp
@@ -0,0 +1,454 @@
+#include "stdafx.h"
+#include "LoadProfiler.h"
+#include "Symbols.h"
+
+#include <psapi.h>
+#pragma comment(lib, "psapi.lib")
+#include <tlhelp32.h>
+#include <algorithm>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace
+{
+    constexpr DWORD SampleIntervalMs = 15;
+    constexpr size_t MaxSamples = 40000;          // ~10 min at 15 ms
+    constexpr size_t MaxFrames = 16;
+    constexpr size_t StackCopyBytes = 16 * 1024;
+
+    struct Sample
+    {
+        DWORD Eip;
+        DWORD Frames[MaxFrames];
+        BYTE FrameCount;
+    };
+
+    struct ModuleRange
+    {
+        DWORD Base;
+        DWORD End;
+    };
+
+    bool s_bEnabled = true;
+    HANDLE s_hMainThread = nullptr;
+    DWORD s_dwMainThreadId = 0;
+    HANDLE s_hSampler = nullptr;
+    HANDLE s_hWake = nullptr;                    // auto-reset: start sampling
+    volatile LONG s_lSampling = 0;               // 1 while a map loads
+    volatile LONG s_lSamplerIdle = 1;            // 1 when the sampler is not touching the buffers
+    DWORD s_dwStackBase = 0;                     // main thread stack range
+    DWORD s_dwStackLimit = 0;
+
+    Sample* s_pSamples = nullptr;                // preallocated, no allocation while sampling
+    volatile LONG s_lSampleCount = 0;
+    volatile LONG s_lSuspendFailures = 0;
+    volatile LONG s_lContextFailures = 0;
+    BYTE* s_pStackCopy = nullptr;
+
+    ModuleRange s_Modules[512];
+    int s_iModuleCount = 0;
+
+    ULONGLONG s_ullBeginTick = 0;
+    FILETIME s_ftMainKernel0 = {}, s_ftMainUser0 = {};
+    // Allocated on first use: UE1 replaces global operator new with GMalloc,
+    // which does not exist yet during static initialization.
+    using ThreadTimes = std::map<DWORD, std::pair<ULONGLONG, ULONGLONG>>;   // tid -> (kernel, user) 100ns
+    ThreadTimes* s_pThreadTimes0 = nullptr;
+
+    ULONGLONG FileTimeToU64(const FILETIME& ft)
+    {
+        return (static_cast<ULONGLONG>(ft.dwHighDateTime) << 32) | ft.dwLowDateTime;
+    }
+
+    // ---- module table (taken on the main thread, read by the sampler) ----
+
+    void SnapshotModules()
+    {
+        HMODULE hMods[512];
+        DWORD cbNeeded = 0;
+        s_iModuleCount = 0;
+        if (!EnumProcessModules(GetCurrentProcess(), hMods, sizeof(hMods), &cbNeeded))
+        {
+            return;
+        }
+        const int iCount = std::min<int>(cbNeeded / sizeof(HMODULE), _countof(hMods));
+        for (int i = 0; i < iCount; ++i)
+        {
+            MODULEINFO mi = {};
+            if (GetModuleInformation(GetCurrentProcess(), hMods[i], &mi, sizeof(mi)))
+            {
+                s_Modules[s_iModuleCount].Base = reinterpret_cast<DWORD>(mi.lpBaseOfDll);
+                s_Modules[s_iModuleCount].End = s_Modules[s_iModuleCount].Base + mi.SizeOfImage;
+                ++s_iModuleCount;
+            }
+        }
+    }
+
+    // True if the 7 bytes before dwAddr lie in a loaded image, so the CALL
+    // check below can't fault (a module base on the stack would, and each
+    // first-chance fault replaces CrashContext's record of the last real one).
+    bool InModule(DWORD dwAddr)
+    {
+        for (int i = 0; i < s_iModuleCount; ++i)
+        {
+            if (dwAddr >= s_Modules[i].Base + 7 && dwAddr < s_Modules[i].End)
+            {
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // ---- sampler thread ----
+
+    // SEH-only helper (no C++ objects): copy the suspended thread's stack.
+    size_t CopyMemorySafe(BYTE* pDst, const BYTE* pSrc, size_t n)
+    {
+        __try
+        {
+            memcpy(pDst, pSrc, n);
+            return n;
+        }
+        __except (EXCEPTION_EXECUTE_HANDLER)
+        {
+            return 0;
+        }
+    }
+
+    // A return address is preceded by a CALL instruction.
+    bool LooksLikeReturnAddress(DWORD dwAddr)
+    {
+        if (!InModule(dwAddr))
+        {
+            return false;
+        }
+        BYTE b[7] = {};
+        if (CopyMemorySafe(b, reinterpret_cast<const BYTE*>(dwAddr - 7), 7) != 7)
+        {
+            return false;
+        }
+        if (b[2] == 0xE8)                                  // call rel32
+            return true;
+        if (b[1] == 0xFF && (b[2] & 0x38) == 0x10)        // call [disp32] / [reg+disp32]
+            return true;
+        if (b[4] == 0xFF && (b[5] & 0x38) == 0x10)        // call [reg+disp8] / call [reg+reg]
+            return true;
+        if (b[5] == 0xFF && (b[6] & 0xF8) == 0xD0)        // call reg
+            return true;
+        if (b[5] == 0xFF && (b[6] & 0x38) == 0x10)        // call [reg]
+            return true;
+        if (b[0] == 0xFF && (b[1] & 0x38) == 0x10)        // call [reg*scale+disp32]
+            return true;
+        return false;
+    }
+
+    void TakeSample()
+    {
+        const LONG lIndex = s_lSampleCount;
+        if (lIndex >= static_cast<LONG>(MaxSamples))
+        {
+            return;
+        }
+        if (SuspendThread(s_hMainThread) == static_cast<DWORD>(-1))
+        {
+            InterlockedIncrement(&s_lSuspendFailures);
+            return;
+        }
+        CONTEXT ctx = {};
+        ctx.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+        const BOOL bContext = GetThreadContext(s_hMainThread, &ctx);
+        size_t nCopied = 0;
+        if (bContext && ctx.Esp >= s_dwStackLimit && ctx.Esp < s_dwStackBase)
+        {
+            const size_t nAvail = s_dwStackBase - ctx.Esp;
+            nCopied = CopyMemorySafe(s_pStackCopy, reinterpret_cast<const BYTE*>(ctx.Esp), std::min(nAvail, StackCopyBytes));
+        }
+        ResumeThread(s_hMainThread);
+
+        if (!bContext)
+        {
+            InterlockedIncrement(&s_lContextFailures);
+            return;
+        }
+
+        // Analyse after resuming: no work while the main thread is frozen.
+        Sample& s = s_pSamples[lIndex];
+        s.Eip = ctx.Eip;
+        s.FrameCount = 0;
+        for (size_t off = 0; off + 4 <= nCopied && s.FrameCount < MaxFrames; off += 4)
+        {
+            const DWORD dwValue = *reinterpret_cast<const DWORD*>(s_pStackCopy + off);
+            if (LooksLikeReturnAddress(dwValue))
+            {
+                s.Frames[s.FrameCount++] = dwValue;
+            }
+        }
+        s_lSampleCount = lIndex + 1;
+    }
+
+    DWORD WINAPI SamplerProc(LPVOID)
+    {
+        for (;;)
+        {
+            WaitForSingleObject(s_hWake, INFINITE);
+            InterlockedExchange(&s_lSamplerIdle, 0);
+            for (unsigned n = 0; s_lSampling; ++n)
+            {
+                // Modules loaded mid-load (renderer, audio, their runtimes)
+                // only count as stack frames once they are in the table.
+                if (n % 64 == 63)
+                {
+                    SnapshotModules();
+                }
+                TakeSample();
+                Sleep(SampleIntervalMs);
+            }
+            InterlockedExchange(&s_lSamplerIdle, 1);
+        }
+    }
+
+    // ---- per-thread CPU times ----
+
+    std::map<DWORD, std::pair<ULONGLONG, ULONGLONG>> SnapshotThreadTimes()
+    {
+        std::map<DWORD, std::pair<ULONGLONG, ULONGLONG>> times;
+        const HANDLE hSnap = CreateToolhelp32Snapshot(TH32CS_SNAPTHREAD, 0);
+        if (hSnap == INVALID_HANDLE_VALUE)
+        {
+            return times;
+        }
+        THREADENTRY32 te = {};
+        te.dwSize = sizeof(te);
+        const DWORD dwPid = GetCurrentProcessId();
+        for (BOOL b = Thread32First(hSnap, &te); b; b = Thread32Next(hSnap, &te))
+        {
+            if (te.th32OwnerProcessID != dwPid)
+                continue;
+            const HANDLE hThread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, te.th32ThreadID);
+            if (!hThread)
+                continue;
+            FILETIME ftC, ftE, ftK, ftU;
+            if (GetThreadTimes(hThread, &ftC, &ftE, &ftK, &ftU))
+            {
+                times[te.th32ThreadID] = { FileTimeToU64(ftK), FileTimeToU64(ftU) };
+            }
+            CloseHandle(hThread);
+        }
+        CloseHandle(hSnap);
+        return times;
+    }
+
+    std::wstring ThreadName(DWORD dwTid)
+    {
+        std::wstring name;
+        using PFN_GetThreadDescription = HRESULT(WINAPI*)(HANDLE, PWSTR*);
+        static const auto pfn = reinterpret_cast<PFN_GetThreadDescription>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "GetThreadDescription"));
+        if (!pfn)
+            return name;
+        const HANDLE hThread = OpenThread(THREAD_QUERY_LIMITED_INFORMATION, FALSE, dwTid);
+        if (!hThread)
+            return name;
+        PWSTR psz = nullptr;
+        if (SUCCEEDED(pfn(hThread, &psz)) && psz)
+        {
+            name = psz;
+            LocalFree(psz);
+        }
+        CloseHandle(hThread);
+        return name;
+    }
+
+    template <typename Map>
+    void LogTop(const wchar_t* pszTitle, const Map& counts, size_t nTotal, size_t nTop)
+    {
+        std::vector<std::pair<size_t, std::wstring>> sorted;
+        for (const auto& kv : counts)
+            sorted.emplace_back(kv.second, kv.first);
+        std::sort(sorted.begin(), sorted.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+        GLog->Logf(L"LoadProfile: --- %s ---", pszTitle);
+        for (size_t i = 0; i < sorted.size() && i < nTop; ++i)
+        {
+            GLog->Logf(L"LoadProfile: %5.1f%% %6u  %s", 100.0 * sorted[i].first / std::max<size_t>(nTotal, 1),
+                static_cast<unsigned>(sorted[i].first), sorted[i].second.c_str());
+        }
+    }
+
+    void Report()
+    {
+        const ULONGLONG ullWallMs = GetTickCount64() - s_ullBeginTick;
+        const size_t nSamples = static_cast<size_t>(s_lSampleCount);
+
+        FILETIME ftC, ftE, ftK, ftU;
+        GetThreadTimes(GetCurrentThread(), &ftC, &ftE, &ftK, &ftU);
+        const double dMainKernelMs = (FileTimeToU64(ftK) - FileTimeToU64(s_ftMainKernel0)) / 10000.0;
+        const double dMainUserMs = (FileTimeToU64(ftU) - FileTimeToU64(s_ftMainUser0)) / 10000.0;
+
+        GLog->Logf(L"LoadProfile: load took %.1f s; main thread CPU user %.1f s, kernel %.1f s; %u samples (%u suspend failures, %u context failures).",
+            ullWallMs / 1000.0, dMainUserMs / 1000.0, dMainKernelMs / 1000.0,
+            static_cast<unsigned>(nSamples), static_cast<unsigned>(s_lSuspendFailures), static_cast<unsigned>(s_lContextFailures));
+
+        // CPU time per thread during the task
+        const auto times1 = SnapshotThreadTimes();
+        std::vector<std::pair<double, DWORD>> busy;
+        for (const auto& kv : times1)
+        {
+            const auto it0 = s_pThreadTimes0->find(kv.first);
+            const ULONGLONG k0 = it0 != s_pThreadTimes0->end() ? it0->second.first : 0;
+            const ULONGLONG u0 = it0 != s_pThreadTimes0->end() ? it0->second.second : 0;
+            busy.emplace_back(((kv.second.first - k0) + (kv.second.second - u0)) / 10000.0, kv.first);
+        }
+        std::sort(busy.begin(), busy.end(), [](const auto& a, const auto& b) { return a.first > b.first; });
+        for (size_t i = 0; i < busy.size() && i < 8; ++i)
+        {
+            const DWORD tid = busy[i].second;
+            const auto& t1 = times1.at(tid);
+            const auto it0 = s_pThreadTimes0->find(tid);
+            const double dK = (t1.first - (it0 != s_pThreadTimes0->end() ? it0->second.first : 0)) / 10000.0;
+            const double dU = (t1.second - (it0 != s_pThreadTimes0->end() ? it0->second.second : 0)) / 10000.0;
+            GLog->Logf(L"LoadProfile: thread %u%s '%s': user %.1f s, kernel %.1f s", tid,
+                tid == s_dwMainThreadId ? L" (main)" : L"", ThreadName(tid).c_str(), dU / 1000.0, dK / 1000.0);
+        }
+
+        if (nSamples == 0)
+        {
+            return;
+        }
+
+        const std::vector<Symbols::ExportTable> tables = Symbols::BuildExportTables();
+        std::unordered_map<std::wstring, size_t> leaf, leafModule, firstGame, callers, chains;
+        for (size_t i = 0; i < nSamples; ++i)
+        {
+            const Sample& s = s_pSamples[i];
+            const std::wstring leafSym = Symbols::Symbolize(tables, s.Eip);
+            ++leaf[leafSym];
+            ++leafModule[Symbols::Symbolize(tables, s.Eip, true)];
+
+            // caller of the leaf (first plausible return address) and the
+            // first frame inside a game/launcher module
+            std::wstring firstGameSym = L"(none)";
+            for (BYTE f = 0; f < s.FrameCount; ++f)
+            {
+                if (!Symbols::IsSystemModule(Symbols::Symbolize(tables, s.Frames[f], true)))
+                {
+                    firstGameSym = Symbols::Symbolize(tables, s.Frames[f]);
+                    break;
+                }
+            }
+            ++firstGame[firstGameSym];
+            if (s.FrameCount > 0)
+            {
+                ++callers[leafSym + L"  <-  " + Symbols::Symbolize(tables, s.Frames[0])];
+            }
+            std::wstring chain = leafSym;
+            BYTE nGame = 0;
+            for (BYTE f = 0; f < s.FrameCount && nGame < 4; ++f)
+            {
+                const std::wstring mod = Symbols::Symbolize(tables, s.Frames[f], true);
+                if (Symbols::IsSystemModule(mod) && nGame == 0 && f > 3)
+                    continue;
+                chain += L"  <-  " + Symbols::Symbolize(tables, s.Frames[f]);
+                if (!Symbols::IsSystemModule(mod))
+                    ++nGame;
+            }
+            ++chains[chain];
+        }
+        LogTop(L"leaf module (where EIP was)", leafModule, nSamples, 12);
+        LogTop(L"leaf function", leaf, nSamples, 25);
+        LogTop(L"leaf <- caller", callers, nSamples, 25);
+        LogTop(L"first game/launcher frame on the stack", firstGame, nSamples, 25);
+        LogTop(L"stack chains (leaf <- ... up to 4 game frames)", chains, nSamples, 15);
+    }
+}
+
+void LoadProfiler::ReadConfig()
+{
+    UBOOL bEnabled = FALSE; //Diagnostics only: SuspendThread sampling costs time under Wine
+    GConfig->GetBool(PROJECTNAME, L"LoadProfiler", bEnabled);
+    s_bEnabled = bEnabled != FALSE;
+    GLog->Logf(L"Load profiler: %s.", s_bEnabled ? L"on" : L"off");
+}
+
+void LoadProfiler::OnLoadBegin()
+{
+    if (!s_bEnabled || s_lSampling)
+    {
+        return;
+    }
+    if (!s_hSampler)
+    {
+        if (!DuplicateHandle(GetCurrentProcess(), GetCurrentThread(), GetCurrentProcess(), &s_hMainThread,
+            THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION, FALSE, 0))
+        {
+            s_bEnabled = false;
+            return;
+        }
+        s_dwMainThreadId = GetCurrentThreadId();
+        const NT_TIB* const pTib = reinterpret_cast<const NT_TIB*>(NtCurrentTeb());
+        s_dwStackBase = reinterpret_cast<DWORD>(pTib->StackBase);
+        s_dwStackLimit = reinterpret_cast<DWORD>(pTib->StackLimit);
+        // The reserved stack may be larger than the committed StackLimit; the
+        // copy is guarded by SEH anyway, so allow the whole reservation.
+        MEMORY_BASIC_INFORMATION mbi = {};
+        if (VirtualQuery(reinterpret_cast<LPCVOID>(s_dwStackBase - 1), &mbi, sizeof(mbi)))
+        {
+            s_dwStackLimit = reinterpret_cast<DWORD>(mbi.AllocationBase);
+        }
+        s_pSamples = static_cast<Sample*>(VirtualAlloc(nullptr, sizeof(Sample) * MaxSamples, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+        s_pStackCopy = static_cast<BYTE*>(VirtualAlloc(nullptr, StackCopyBytes, MEM_COMMIT | MEM_RESERVE, PAGE_READWRITE));
+        s_hWake = CreateEventW(nullptr, FALSE, FALSE, nullptr);
+        if (!s_pSamples || !s_pStackCopy || !s_hWake)
+        {
+            s_bEnabled = false;
+            return;
+        }
+        s_hSampler = CreateThread(nullptr, 64 * 1024, SamplerProc, nullptr, 0, nullptr);
+        if (!s_hSampler)
+        {
+            s_bEnabled = false;
+            return;
+        }
+        SetThreadPriority(s_hSampler, THREAD_PRIORITY_ABOVE_NORMAL);
+    }
+
+    // Wait until a previous sampling run has fully stopped.
+    while (!s_lSamplerIdle)
+    {
+        Sleep(1);
+    }
+    SnapshotModules();
+    if (!s_pThreadTimes0)
+    {
+        s_pThreadTimes0 = new ThreadTimes();
+    }
+    *s_pThreadTimes0 = SnapshotThreadTimes();
+    FILETIME ftC, ftE;
+    GetThreadTimes(GetCurrentThread(), &ftC, &ftE, &s_ftMainKernel0, &s_ftMainUser0);
+    s_lSampleCount = 0;
+    s_lSuspendFailures = 0;
+    s_lContextFailures = 0;
+    s_ullBeginTick = GetTickCount64();
+    InterlockedExchange(&s_lSampling, 1);
+    SetEvent(s_hWake);
+}
+
+void LoadProfiler::OnLoadEnd()
+{
+    if (!s_bEnabled || !s_lSampling)
+    {
+        return;
+    }
+    InterlockedExchange(&s_lSampling, 0);
+    while (!s_lSamplerIdle)
+    {
+        Sleep(1);
+    }
+    Report();
+}
+
+void LoadProfiler::Shutdown()
+{
+    s_bEnabled = false;
+    InterlockedExchange(&s_lSampling, 0);
+}
diff --git a/launcher/src/LoadProfiler.h b/launcher/src/LoadProfiler.h
new file mode 100644
index 0000000..a4b4502
--- /dev/null
+++ b/launcher/src/LoadProfiler.h
@@ -0,0 +1,26 @@
+#pragma once
+
+// Sampling profiler for level / savegame loads.
+//
+// Level loads on the Android tablet (Wine + FEX) take minutes while the main
+// thread is mostly sleeping. Without root there is no perf/strace there, so
+// this measures from inside the process: while a map loads, a helper
+// thread periodically suspends the main thread, records EIP and the return
+// addresses found on its stack, and resumes it. When the new level is up the
+// samples are symbolized via the modules' export tables and a summary goes to
+// the log ("LoadProfile: ..."), plus per-thread CPU time during the load.
+//
+// Off by default; [DeusExe] LoadProfiler=True enables it.
+namespace LoadProfiler
+{
+    void ReadConfig();
+
+    // Called on the main thread: when the engine logs "LoadMap: ..." and when
+    // CLevelWatch sees the new level.
+    void OnLoadBegin();
+    void OnLoadEnd();
+
+    // Stops sampling without a report (crash paths); doesn't wait for the
+    // sampler thread.
+    void Shutdown();
+}
